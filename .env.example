# Supertext Translation for Shopify: environment variables.
# Copy to .env for local development. On Railway, set them as service
# variables. Never commit real values.

# --- Shopify (Dev Dashboard → your app → Settings) -----------------------
# Client ID (public; also in shopify.app.toml).
SHOPIFY_API_KEY=d001de0fc4c060b4b044489f7992553a
# Client secret. Secret: only in .env / Railway variables.
SHOPIFY_API_SECRET=
# Public URL of this backend, e.g. https://shopify-supertext-translation.up.railway.app
SHOPIFY_APP_URL=
# Must match [access_scopes] in shopify.app.toml.
SCOPES=read_products,read_content,read_locales,read_translations,write_translations

# --- Database -------------------------------------------------------------
# Any database on the Postgres server; the start script creates and uses
# SHOPIFY_DB_NAME on that server.
DATABASE_URL=postgresql://user:password@localhost:5432/postgres
SHOPIFY_DB_NAME=shopify_supertext

# --- Supertext --------------------------------------------------------------
# Optional default API key for shops that haven't entered their own under
# Settings (e.g. the demo store).
# No Supertext account yet? Create one at https://www.supertext.com/person/en/account/signin
# Generate your API key at https://www.supertext.com/en/integrations/api (requires the Admin role).
SUPERTEXT_API_KEY=
# Optional: a stand-in API for tests and screenshots (default: the live API).
# SUPERTEXT_API_ENDPOINT=https://api.supertext.com/v1/
